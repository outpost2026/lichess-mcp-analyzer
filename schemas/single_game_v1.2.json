{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lichess-analyzer-mcp/schemas/single_game_v1.2.json",
  "title": "lichess_coaching_single_game response",
  "description": "Contract v1.2 - additive over v1.1 (schemas/single_game_v1.1.json is the historical snapshot). P0-7: every flagged move is either covered by a pattern (pattern_status=matched) or states why not (pattern_status=unclassified, unclassified_reason present). patterns_meta carries the coverage counts and the reason histogram. The top-level `unclassified` array is the discovery feed: critical moments no pattern explains.",
  "type": "object",
  "required": [
    "schema_version",
    "game_id",
    "username",
    "color",
    "mode",
    "depth",
    "status",
    "partial",
    "errors",
    "unanalyzed_plies",
    "timings",
    "engine",
    "cache",
    "analysis",
    "flagged_moves",
    "patterns",
    "patterns_meta",
    "unclassified",
    "llm",
    "report",
    "report_meta",
    "cascade_log"
  ],
  "properties": {
    "schema_version": { "const": "1.2" },
    "game_id": { "type": "string", "minLength": 1 },
    "username": { "type": "string" },
    "color": { "enum": ["white", "black"] },
    "mode": { "enum": ["fast", "deep"] },
    "depth": { "type": "integer", "minimum": 8, "maximum": 24 },
    "status": { "enum": ["ok", "degraded", "partial", "error"] },
    "pipeline": {
      "type": "object",
      "description": "2.4 additive: separates analysis completeness from coaching source. `status` can be degraded because the LLM was disabled; that is not an analysis failure.",
      "required": ["analysis", "coaching", "llm_requested"],
      "additionalProperties": false,
      "properties": {
        "analysis": { "enum": ["complete", "partial", "failed"] },
        "coaching": {
          "enum": ["llm", "deterministic_fallback", "data_only", "failed"]
        },
        "llm_requested": { "type": "boolean" }
      }
    },
    "partial": { "type": "boolean" },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code"],
        "properties": {
          "code": { "type": "string" },
          "ply": { "type": ["integer", "null"] },
          "message": { "type": "string" }
        }
      }
    },
    "unanalyzed_plies": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 }
    },
    "timings": {
      "type": "object",
      "required": [
        "io_s",
        "engine_s",
        "llm_s",
        "overhead_s",
        "total_s",
        "deadline_s",
        "engine_calls",
        "engine_timeouts"
      ],
      "properties": {
        "io_s": { "type": "number", "minimum": 0 },
        "engine_s": { "type": "number", "minimum": 0 },
        "llm_s": { "type": "number", "minimum": 0 },
        "overhead_s": { "type": "number", "minimum": 0 },
        "total_s": { "type": "number", "minimum": 0 },
        "deadline_s": { "type": "number", "exclusiveMinimum": 0 },
        "budget_used": { "type": ["number", "null"], "minimum": 0 },
        "engine_calls": { "type": "integer", "minimum": 0 },
        "engine_timeouts": { "type": "integer", "minimum": 0 },
        "engine_retries": { "type": "integer", "minimum": 0 },
        "cache_hit": { "type": "boolean" },
        "llm_skipped": {
          "type": "boolean",
          "description": "D28: true when no LLM provider was contacted (llm disabled, no key, negative cache). Makes llm_s=0.0 unambiguous."
        },
        "llm_skip_reason": {
          "type": ["string", "null"],
          "enum": [
            "llm_disabled",
            "no_provider_configured",
            "no_api_key",
            "negative_cache",
            "unknown_provider",
            "all_providers_skipped",
            "pipeline_error",
            null
          ],
          "description": "D28: why the LLM stage was skipped. null = at least one provider was actually contacted."
        }
      }
    },
    "engine": {
      "type": "object",
      "required": ["limit", "depth", "nodes_cap", "hash_mb", "threads"],
      "properties": {
        "limit": { "type": "string" },
        "depth": { "type": "integer" },
        "nodes_cap": { "type": ["integer", "null"] },
        "hash_mb": { "type": ["integer", "null"] },
        "threads": { "type": ["integer", "null"] }
      }
    },
    "cache": {
      "type": "object",
      "required": ["hit", "layer", "key"],
      "properties": {
        "hit": { "type": "boolean" },
        "layer": { "type": "string" },
        "key": { "type": ["string", "null"] }
      }
    },
    "analysis": {
      "type": "object",
      "required": [
        "acpl",
        "accuracy",
        "moves_analyzed",
        "moves_total",
        "evaluation_errors",
        "phase_stats"
      ],
      "properties": {
        "acpl": { "type": ["number", "null"], "minimum": 0 },
        "accuracy": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "accuracy_method": { "type": "string" },
        "accuracy_warning": {
          "type": ["string", "null"],
          "enum": ["contains_mate_level_outlier", "contains_blunder", "contains_mistake", null],
          "description": "D33/P1-1: the strongest error class hidden by the linear accuracy score. null = no mistake above 150 cp."
        },
        "run_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$",
          "description": "P0-6: deterministic fingerprint of the analysis policy (depth, mode, node cap, threads, detector version, schema version). Engine identity is not folded in: a cache hit starts no engine. Identical policy -> identical id."
        },
        "eval_provenance": {
          "type": "object",
          "description": "P0-6 / T-02: per-payload provenance of the evaluation numbers. Counts only measured moves. N-03: the D12 anchor exists only on newer analyses; anchor_coverage says how much of THIS payload is reconstructible.",
          "required": ["moves_measured", "anchor_coverage", "cp_loss_basis", "eval_source"],
          "additionalProperties": false,
          "properties": {
            "moves_measured": { "type": "integer", "minimum": 0 },
            "anchor_coverage": {
              "type": ["number", "null"],
              "minimum": 0,
              "maximum": 1,
              "description": "Share of measured moves whose cp_loss is reconstructible from best_eval. null = no move was measured."
            },
            "cp_loss_basis": {
              "type": "object",
              "additionalProperties": { "type": "integer", "minimum": 1 },
              "description": "Counts by basis: best_eval (anchor present and reconstructing) / unknown (legacy cache, cloud eval, non-reconstructing triple). Empty object when nothing was measured."
            },
            "eval_source": {
              "type": "object",
              "additionalProperties": { "type": "integer", "minimum": 1 },
              "description": "Counts by source: stockfish / cloud / unknown. Empty object when nothing was measured."
            }
          }
        },
        "confidence_dimensions": {
          "type": "object",
          "description": "P0-4: names the three confidence dimensions so `confidence` cannot be mistaken for a probability.",
          "required": [
            "kinds",
            "published_kind",
            "support_basis",
            "behavioral_confidence",
            "behavioral_confidence_reason",
            "n_patterns"
          ],
          "properties": {
            "kinds": {
              "type": "array",
              "items": { "enum": ["detection_strength", "evidence_support", "behavioral_confidence"] }
            },
            "published_kind": { "const": "detection_strength" },
            "support_basis": { "const": "flagged_moves_in_game" },
            "behavioral_confidence": { "const": null },
            "behavioral_confidence_reason": { "const": "not_calibrated" },
            "n_patterns": { "type": "integer", "minimum": 0 }
          }
        },
        "internal_accuracy_score": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "moves_analyzed": { "type": "integer", "minimum": 0 },
        "moves_total": { "type": "integer", "minimum": 0 },
        "player_moves_total": { "type": "integer", "minimum": 0 },
        "game_plies_total": { "type": ["integer", "null"], "minimum": 1 },
        "opponent_moves_total": { "type": ["integer", "null"], "minimum": 0 },
        "evaluation_errors": { "type": "integer", "minimum": 0 },
        "phase_stats": { "type": "object" },
        "segment_stats": { "type": "object" },
        "chess_phase_stats": { "type": "object" }
      }
    },
    "flagged_moves": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ply",
          "san",
          "classification",
          "cp_loss",
          "phase",
          "engine_lines",
          "explanation",
          "explanation_source",
          "pattern_status"
        ],
        "properties": {
          "ply": { "type": "integer" },
          "san": { "type": "string" },
          "uci": { "type": "string" },
          "classification": { "enum": ["blunder", "mistake", "inaccuracy"] },
          "cp_loss": { "type": "number", "minimum": 0 },
          "eval_before": { "type": ["number", "null"] },
          "eval_after": { "type": ["number", "null"] },
          "eval_before_mover_cp": { "type": ["number", "null"] },
          "eval_after_mover_cp": { "type": ["number", "null"] },
          "best_eval_mover_cp": { "type": ["number", "null"] },
          "cp_loss_basis": {
            "type": ["string", "null"],
            "enum": ["best_eval", "unknown", null],
            "description": "P0-6: what the published cp_loss was measured from. `best_eval` only when the D12 anchor is present and reconstructs within 1 cp; `unknown` without an anchor (legacy cache, cloud eval, non-reconstructing triple). Derived from the published anchor when the field was not recorded, so it always agrees with analysis.eval_provenance; null only in payloads that predate the field entirely."
          },
          "eval_source": {
            "type": ["string", "null"],
            "description": "P0-6/P0-4: exact engine policy that measured the eval pair, e.g. stockfish_d14_n150000_h512_live or stockfish_d14_n150000_h512_cache_run_6d1af884; `hash_unknown` when the legacy cache has no hash metadata. `cloud`/`unknown`/null are legacy or non-engine values."
          },
          "game_impact": {
            "type": ["string", "null"],
            "enum": [
              "winning_to_winning",
              "winning_to_equal",
              "winning_to_losing",
              "winning_to_mate",
              "equal_to_winning",
              "equal_to_equal",
              "equal_to_losing",
              "equal_to_mate",
              "losing_to_winning",
              "losing_to_equal",
              "losing_to_losing",
              "losing_to_mate",
              null
            ],
            "description": "D15: did the game change, from the mover's point of view. Nine sign transitions with a documented +/-100 cp dead zone, plus three mate transitions; a forced mate is never reported as losing_to_losing. null = eval not measured."
          },
          "mate_after": {
            "type": ["string", "null"],
            "enum": ["for", "against", null],
            "description": "D15: direction of the forced mate after the move. 'for' = the mover mates, 'against' = the mover is mated. Present only together with a *_to_mate game_impact."
          },
          "mate_missed": {
            "type": ["integer", "null"],
            "minimum": 1,
            "description": "D31: the engine's best line mates for the mover in N moves and the played move does not reach a forced mate. null = no mate was available, or it was not measured."
          },
          "mate_via": {
            "type": ["string", "null"],
            "description": "D31: SAN of the mating move the engine found. Present only together with mate_missed."
          },
          "win_prob_before": { "type": ["number", "null"] },
          "win_prob_after": { "type": ["number", "null"] },
          "phase": { "type": "string" },
          "best_move_san": { "type": ["string", "null"] },
          "played_rank": { "type": ["integer", "null"] },
          "engine_lines": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["rank", "san", "eval_cp", "pv"],
              "properties": {
                "rank": { "type": "integer", "minimum": 1 },
                "san": { "type": "string" },
                "eval_cp": { "type": ["number", "null"] },
                "pv": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "pv_played": {
            "type": "array",
            "items": { "type": "string" },
            "description": "D32: engine continuation after the played move, from the same multipv search. An engine line, not the opponent's actual reply."
          },
          "pv_played_unavailable": {
            "type": ["string", "null"],
            "enum": ["no_engine_lines", "rank_not_in_engine_lines", "no_continuation", null],
            "description": "D32: why pv_played is empty. null = a continuation exists."
          },
          "motif": { "type": ["string", "null"] },
          "check": { "type": "boolean" },
          "in_check_before": { "type": "boolean" },
          "explanation": { "type": "string" },
          "explanation_source": { "enum": ["deterministic", "llm", "none"] },
          "pattern_status": { "enum": ["matched", "unclassified"] },
          "unclassified_reason": {
            "type": ["string", "null"],
            "enum": [
              "evidence_gap",
              "quiet_positional",
              "quiet_blunder",
              "check_escape",
              "forcing_move_unexplained",
              "capture_unexplained",
              "mechanism_not_identified",
              "not_classified",
              null
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "pattern_status": { "const": "unclassified" } },
              "required": ["pattern_status"]
            },
            "then": {
              "required": ["unclassified_reason"],
              "properties": { "unclassified_reason": { "type": "string" } }
            },
            "else": {
              "properties": { "unclassified_reason": { "const": null } }
            }
          }
        ]
      }
    },
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pattern_id", "pattern_name", "confidence", "frequency", "scope"],
        "properties": {
          "pattern_id": { "type": "string" },
          "pattern_name": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "frequency": { "type": "integer", "minimum": 1 },
          "severity": { "type": "string" },
          "scope": { "const": "single_game" },
          "detection_strength": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "P0-4: ordinal detector strength. Same number as `strength` and the deprecated `confidence` alias; not a probability."
          },
          "evidence_support": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1,
            "description": "P0-4: measured share of flagged moves in this game covered by the pattern (basis and denominator in evidence_support_basis / evidence_support_n_units). null = no measured move."
          },
          "evidence_support_basis": { "const": "flagged_moves_in_game" },
          "evidence_support_n_units": { "type": "integer", "minimum": 0 },
          "behavioral_confidence": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1,
            "description": "P0-4: calibrated confidence in the mechanism. null until calibration (Phase 3); reason in behavioral_confidence_reason."
          },
          "behavioral_confidence_reason": { "const": "not_calibrated" },
          "confidence_kind": {
            "enum": ["detection_strength", "evidence_support", "behavioral_confidence"],
            "description": "P0-4: which dimension the legacy `confidence` alias names."
          },
          "evidence": { "type": "array" },
          "affected_games": { "type": "array", "items": { "type": "string" } },
          "mitigation": { "type": "string" }
        }
      }
    },
    "patterns_meta": {
      "type": "object",
      "required": ["scope", "cross_game_suppressed", "reason", "coverage"],
      "properties": {
        "scope": { "const": "single_game" },
        "cross_game_suppressed": { "const": true },
        "reason": { "type": "string", "minLength": 1 },
        "detector_version": { "type": "string" },
        "coverage": {
          "type": "object",
          "required": ["flagged", "matched", "unclassified"],
          "properties": {
            "flagged": { "type": "integer", "minimum": 0 },
            "matched": { "type": "integer", "minimum": 0 },
            "unclassified": { "type": "integer", "minimum": 0 }
          }
        },
        "unclassified_reasons": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "unclassified": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ply", "san", "class", "cp_loss", "reason"],
        "properties": {
          "ply": { "type": "integer" },
          "san": { "type": "string" },
          "class": { "enum": ["blunder", "mistake", "inaccuracy"] },
          "cp_loss": { "type": ["number", "null"] },
          "reason": { "type": "string" }
        }
      }
    },
    "llm": {
      "type": "object",
      "required": ["status", "provider", "degraded", "reason", "attempts", "timeout_s", "tokens"],
      "properties": {
        "status": { "enum": ["ok", "degraded", "disabled"] },
        "provider": { "type": ["string", "null"] },
        "degraded": { "type": "boolean" },
        "reason": { "type": "string" },
        "attempts": { "type": "array" },
        "configured_providers": { "type": "integer", "minimum": 0 },
        "timeout_s": { "type": "number", "minimum": 0 },
        "tokens": {
          "type": "object",
          "required": ["input", "output"],
          "properties": {
            "input": { "type": "integer", "minimum": 0 },
            "output": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "report": { "type": "string" },
    "report_meta": {
      "type": "object",
      "required": ["source", "format", "chars"],
      "properties": {
        "source": { "enum": ["llm", "deterministic", "data_dump", "none"] },
        "format": { "const": "markdown" },
        "chars": { "type": "integer", "minimum": 0 }
      }
    },
    "cascade_log": { "type": "array" },
    "flags": { "type": "object" },
    "error": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "llm": { "properties": { "status": { "not": { "const": "ok" } } } } } },
      "then": {
        "properties": {
          "report_meta": { "properties": { "source": { "not": { "const": "llm" } } } }
        }
      }
    }
  ]
}
